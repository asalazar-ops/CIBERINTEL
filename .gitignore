# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secretos y credenciales — NUNCA versionar
.env
.env.*
!.env.example

# Material criptográfico del canal de sensores (HTTPS :8443)
server.key
server.cert
*.pem

# Configuración del agente: contiene el token compartido
agent/agent.config.json
!agent/agent.config.example.json

# Datos en tiempo de ejecución (se regeneran solos)
sensors.db
sensors.db-journal
data.json
assets.json
agent/agent_id.txt
agent/__pycache__/

# Artefactos de build de PyInstaller/Inno Setup — se regeneran con
# agent/build_exe.ps1. El .exe final versionado que sirve el dashboard vive
# en public/sensor-setup.exe (una copia deliberada, no este directorio).
agent/build/
agent/dist/
agent/sensor.spec
agent/installer/output/

# Base local embebida (solo desarrollo sin Turso configurado)
server/local.db
server/local.db-*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
