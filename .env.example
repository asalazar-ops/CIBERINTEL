# CyberIntel EC — plantilla de configuración.
# Copiar a `.env` y rellenar. El archivo `.env` está en .gitignore: nunca se versiona.

# Apify — Deep Recon y Brand Protection Monitor.
# Obtener en: https://console.apify.com/account/integrations
APIFY_TOKEN=

# AlienVault OTX — pulses, indicadores y enriquecimiento de telemetría del EDR.
# Sin esta clave la integración OTX queda deshabilitada (el servidor arranca igual).
# Obtener en: https://otx.alienvault.com/api
OTX_API_KEY=

# Token compartido que autentica a los sensores contra el canal HTTPS :8443.
# OBLIGATORIO: si está vacío el canal de sensores queda cerrado (falla cerrado).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe coincidir con agent_token de agent/agent.config.json en cada endpoint.
AGENT_TOKEN=
