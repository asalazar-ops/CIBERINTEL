# CyberIntel EC — plantilla de configuración.
# Copiar a `.env` y rellenar. El archivo `.env` está en .gitignore: nunca se versiona.

# ─── Base de datos (Turso / libSQL) ───────────────────────────────────────────
# Reemplaza sqlite3 + data.json/assets.json (no funcionan en serverless: el
# disco no persiste entre invocaciones). Si se dejan vacías, el servidor usa un
# archivo local embebido (server/local.db) — solo para desarrollo, NO usar así
# en Vercel. Crear la base en https://turso.tech y obtener ambos valores con:
#   turso db create cyberintel-ec
#   turso db show cyberintel-ec --url
#   turso db tokens create cyberintel-ec
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Apify — Deep Recon y Brand Protection Monitor.
# Obtener en: https://console.apify.com/account/integrations
APIFY_TOKEN=

# AlienVault OTX — pulses, indicadores y enriquecimiento de telemetría del EDR.
# Sin esta clave la integración OTX queda deshabilitada (el servidor arranca igual).
# Obtener en: https://otx.alienvault.com/api
OTX_API_KEY=

# Token compartido que autentica a los sensores contra el canal HTTPS :8443.
# OBLIGATORIO: si está vacío el canal de sensores queda cerrado (falla cerrado).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe coincidir con agent_token de agent/agent.config.json en cada endpoint.
AGENT_TOKEN=

# ─── Login del dashboard (admin único, sin tabla de usuarios) ────────────────
# Firma las cookies de sesión (JWT). OBLIGATORIO: sin esto nadie puede iniciar sesión.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Credenciales del único usuario admin.
ADMIN_EMAIL=
# Generar el hash con: node server/hash_password.js "tu-contraseña"
ADMIN_PASSWORD_HASH=

# Secreto que Apify debe enviar en la cabecera X-Webhook-Secret al llamar a
# /api/webhooks/apify/brand-monitor. OBLIGATORIO: sin esto el webhook queda cerrado.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APIFY_WEBHOOK_SECRET=

# Dominio público de este despliegue (ej. https://tu-app.vercel.app), sin
# barra final. Se le pasa a Apify al disparar POST /api/assets/fb-scraper/:id
# (que usa .start() en vez de .call() para no bloquear la función) para que
# sepa a dónde devolver el resultado. Sin esto, ese endpoint específico queda
# deshabilitado — el resto de la app funciona igual.
APIFY_WEBHOOK_URL=

# Origen permitido por CORS en producción (dominio real de Vercel). En desarrollo
# local se usa http://localhost:5173 por defecto si se deja vacío.
CORS_ORIGIN=

# ─── Cron jobs (Fase 3/5: daily-jobs [feeds+OTX+cleanup], scan-assets) ────────
# Solo 2 jobs, ambos diarios: el plan Hobby de Vercel limita a 2 crons y
# frecuencia diaria. Vercel invoca /api/cron/* con
# "Authorization: Bearer $CRON_SECRET" automáticamente cuando esta variable
# está configurada — no hace falta ninguna otra config en vercel.json.
# OBLIGATORIO: sin esto los 2 endpoints de cron quedan cerrados.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
